# Wix Headless CMS, Members & API Configuration for Dilo Digital
VITE_WIX_CLIENT_ID=2db3573e-2635-43b6-939b-8d52f78f8de9
VITE_SITE_ORIGIN=https://dilodigital.vercel.app

# Optional server-side API Key & Site ID (if configured in Wix Developer Dashboard)
VITE_WIX_SITE_ID=
VITE_WIX_API_KEY=

# ================================================================
# DILO CHECKOUT (#/checkout) — Pasarela de pago propia
# ----------------------------------------------------------------
# Sin STRIPE_SECRET_KEY + STRIPE_PUBLISHABLE_KEY el checkout funciona
# en MODO SIMULADO (tarjetas de prueba de Stripe, sin cargos reales).
# Con llaves sk_test_/pk_test_ -> Stripe modo prueba.
# Con llaves sk_live_/pk_live_ -> cobros reales.
# No requiere recompilar: el frontend lee el modo desde /api/checkout/config.
# ================================================================

# Stripe (Dashboard > Developers > API keys)
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
# Dashboard > Developers > Webhooks > endpoint https://TU-DOMINIO/api/checkout/webhook
# Eventos: payment_intent.succeeded, payment_intent.processing,
#          payment_intent.requires_action, payment_intent.payment_failed
STRIPE_WEBHOOK_SECRET=

# Firma de sesiones del modo simulado (cadena aleatoria larga)
CHECKOUT_SIGNING_SECRET=
# En producción (VERCEL_ENV=production) el modo simulado está apagado;
# sin llaves se muestra "Completar por WhatsApp". Poner true para forzarlo.
CHECKOUT_ALLOW_SIMULATED=
# Orígenes extra permitidos por CORS (separados por coma)
CHECKOUT_ALLOWED_ORIGINS=
# WhatsApp de soporte (con lada país, solo dígitos)
CHECKOUT_SUPPORT_WHATSAPP=525592441070
# Nombre del beneficiario mostrado en instrucciones SPEI
CHECKOUT_BENEFICIARY_NAME=Dilo Digital
# Cupones de descuento (JSON en una sola línea). Campos: percent | amount (MXN),
# categories (["impi","branding"]), minSubtotal (MXN), expires (AAAA-MM-DD), label.
# Ej: {"LANZAMIENTO10":{"percent":10,"categories":["impi"],"expires":"2026-12-31"}}
# El cupón PRUEBA10 existe solo fuera de producción y nunca con sk_live_.
CHECKOUT_COUPONS=

# Meta Pixel (navegador) + Conversions API (servidor)
# Purchase se deduplica con event_id = folio de la orden.
VITE_META_PIXEL_ID=
META_PIXEL_ID=
META_CAPI_ACCESS_TOKEN=
# Events Manager > Probar eventos (solo para QA; dejar vacío en producción)
META_TEST_EVENT_CODE=